<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="service.netotv" name="Neto-IL-TV" version="1.0.31" provider-name="local">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests"/>
    <import addon="resource.language.he_il"/>
    <import addon="skin.dockil" version="0.4.1"/>
    <import addon="script.fentastic.helper" version="0.6.21"/>
    <import addon="plugin.video.netotv" version="1.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Neto-IL-TV: installs Idan+ and sets up the home page: the Idan+ Dock of the DockIL skin.</summary>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="plugin.video.netotv" name="Neto-IL-TV - שורות" version="1.0.0" provider-name="local">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Idan+ live channels split into main and backup rows for the home page.</summary>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="skin.dockil" version="0.4.1" name="DockIL"
	provider-name="David (based on POV-IL FENtastic by Ivar Brandt)">
	<requires>
		<!-- <import addon="xbmc.gui" version="5.17.0" /> -->
		<import addon="script.fentastic.helper" />
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
		<res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
		<res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
		<res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
		<res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
		<res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
		<res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0</license>
		<forum>https://github.com/OrenDdp/DockIL/issues</forum>
		<source>https://github.com/OrenDdp/DockIL</source>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
		</assets>
		<summary lang="en_GB">DockIL: Dock tabs and grids per category, for Kodi POV IL, Umbrella, Fen Light and Idan Plus</summary>
		<summary lang="en_NZ">DockIL: Dock tabs and grids per category, for Kodi POV IL, Umbrella, Fen Light and Idan Plus</summary>
		<summary lang="en_US">DockIL: Dock tabs and grids per category, for Kodi POV IL, Umbrella, Fen Light and Idan Plus</summary>
		<description lang="en_GB">A FENtastic based skin (Ivar Brandt) in which every side-menu category is a Dock of tabs with a grid under it. Works in Kodi POV IL (with its logo and look), and in any Kodi 21 with Umbrella, Fen Light or Idan Plus. Rubik font (SIL OFL 1.1), background photo from Pexels.</description>
		<description lang="en_NZ">A FENtastic based skin (Ivar Brandt) in which every side-menu category is a Dock of tabs with a grid under it. Works in Kodi POV IL (with its logo and look), and in any Kodi 21 with Umbrella, Fen Light or Idan Plus. Rubik font (SIL OFL 1.1), background photo from Pexels.</description>
		<description lang="en_US">A FENtastic based skin (Ivar Brandt) in which every side-menu category is a Dock of tabs with a grid under it. Works in Kodi POV IL (with its logo and look), and in any Kodi 21 with Umbrella, Fen Light or Idan Plus. Rubik font (SIL OFL 1.1), background photo from Pexels.</description>
	</extension>
</addon>
<addon id="script.fentastic.helper" name="FENtastic Helper" version="0.6.21" provider-name="Tikipeter, Ivar Brandt">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.19.1"/>
    </requires>
    <extension point="xbmc.python.library" library="resources/lib/default.py"/>
    <extension point="xbmc.service" library="resources/lib/service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
        <news />
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <forum />
        <source />
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
        <description lang="en_GB">FENtastic Helper for the FENtastic Skin.</description>
        <description lang="en_NZ">FENtastic Helper for the FENtastic Skin.</description>
        <description lang="en_US">FENtastic Helper for the FENtastic Skin.</description>
    </extension>
</addon>
<addon id="repository.netotv" name="Neto-IL-TV repository" version="1.0.0" provider-name="OrenDdp">
  <extension point="xbmc.addon.repository" name="Neto-IL-TV repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/OrenDdp/Neto-IL-TV/main/docs/repo/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/OrenDdp/Neto-IL-TV/main/docs/repo/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/OrenDdp/Neto-IL-TV/main/docs/repo/zips</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Neto-IL-TV: Idan+ with a home page like Kodi POV IL.</summary>
    <platform>all</platform>
  </extension>
</addon>
</addons>
